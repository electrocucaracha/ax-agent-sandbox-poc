{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/mock-model",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "{env:LLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "mock-model": { "name": "mock-model" }
      }
    }
  }
}

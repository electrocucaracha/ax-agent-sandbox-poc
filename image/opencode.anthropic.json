{
  "$schema": "https://opencode.ai/config.json",
  "model": "gateway/claude-sonnet-4-6",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic-format gateway",
      "options": {
        "baseURL": "{env:LLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}",
        "headers": {
          "anthropic-version": "vertex-2023-10-16"
        }
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6"
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow"
  },
  "instructions": ["/opt/AGENTS.md"],
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["engram", "mcp"],
      "enabled": true
    }
  }
}

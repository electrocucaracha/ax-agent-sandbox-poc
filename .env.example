# Optional settings for scripts/10-team-demo.sh.
# Load with: set -a; source .env.example; set +a
# The image build updates image settings in ignored .env.opencode and preserves other entries.

LLM_HOST=mock-llm.default.svc.cluster.local
LLM_PATH=/v1
OC_CONFIG=/opt/opencode.json
EPIC_TIMEOUT=1800
SAMPLE_REPO_URL=https://github.com/pallets/click.git
SAMPLE_REPO_REF=8.1.8

# Only set for a real LLM endpoint; the mock uses per-tenant fake keys by default.
# LLM_API_KEY=replace-with-your-key
# LLM_HOST=llm.example.com
# OC_CONFIG=/opt/opencode.anthropic.json
# LLM_MODEL_ID=claude-sonnet-4@20250514
# LLM_AUTH_MODE=x-api-key
# LLM_EXTRA_HEADERS_JSON='{"X-Provider-Header":"value"}'

# Existing LiteLLM settings are also accepted by the team demo.
# LITELLM_PROXY_API_BASE=https://llm.example.com/gateway
# LITELLM_PROXY_API_KEY=replace-with-your-key
# LITELLM_PROXY_MODEL=anthropic/claude-sonnet-4-6
# LITELLM_EXTRA_HEADERS_JSON='{"WM_LLM_GW.USER_TYPE":"developer","WM_LLM_GW.USER_NAME":"your-user-id"}'

# Set a prebuilt, compatible task image to skip the local image build.
# IMAGE_SOURCE=external
# OPENCODE_IMAGE=registry.example/agent@sha256:<digest>
# Set IMAGE_SOURCE=local to force a local rebuild when .env.opencode has an image reference.

# Optional overrides.
# WORKERS=10
# MUTATION_MEMORY=2Gi
# MUTATION_TIMEOUT=3600
# HOLD_SECONDS=9300 # default: 3 * EPIC_TIMEOUT + MUTATION_TIMEOUT + 300
# GIT_ADMIN_PASS=change-me

# Required only when deploying Headroom with scripts/07-headroom.sh.
# UPSTREAM_URL=https://llm.example.com/gateway
